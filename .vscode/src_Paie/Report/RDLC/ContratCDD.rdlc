            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="En cas de contestation ou de litiges, les tribunaux de la ville de TUNIS seront seuls compétents."</Value>

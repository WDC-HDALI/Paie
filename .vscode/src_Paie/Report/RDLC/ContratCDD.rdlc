          <Textbox Name="Textbox20">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Fields!MaritalStatus.Value &amp; " " &amp; Fields!First_Name.Value &amp; " " &amp; Fields!Last_Name.Value &amp; " s'engage pendant toute la durée du contrat à :"</Value>
                    <Style>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Consacrer toute son activité professionnelle à l'employeur et se conformer strictement aux directives et instructions émanant de la direction ou de son représentant ."</Value>
                    <Style>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Bulleted</ListStyle>
                <ListLevel>1</ListLevel>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Respecter les horaires établis par l'employeur et les prescriptions du réglement intérieur en vigueur dans l'établissement et à ne jamais contrevenir aux lois et règlements en vigueur ."</Value>
                    <Style>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Bulleted</ListStyle>
                <ListLevel>1</ListLevel>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Observer une discrétion professionnelle absolue pour tout ce qui concerne les faits ou informations dont il aura connaissace dans l'exercice ou à l'occasion les faits ou informations dont il aura connaissance dans l'exercice ou à l'occasion de ses fonctions faute de quoi il encourt des poursuites judiciaires . "</Value>
                    <Style>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Bulleted</ListStyle>
                <ListLevel>1</ListLevel>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="A ne pas travailler chez un concurrent au cas où il quitte la société pendant une durée de 5 ans ."</Value>
                    <Style>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Bulleted</ListStyle>
                <ListLevel>1</ListLevel>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Veiller à la conservation des choses qui lui ont été remises pour l'accomplissement des services dont il est chargé. Il doit les restituer après l'accomplissement de son travail et il répond de la perte ou de la détérioration imputable à sa faute."</Value>
                    <Style>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <ListStyle>Bulleted</ListStyle>
                <ListLevel>1</ListLevel>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>Textbox2</rd:DefaultName>
            <Top>29.60475cm</Top>
            <Left>0.03602cm</Left>
            <Height>3.08708cm</Height>
            <Width>18.64267cm</Width>

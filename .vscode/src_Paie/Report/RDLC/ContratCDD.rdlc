              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Faite de bonne foi, en autant d'exemplaires que de parties, à   ARIANA , le "</Value>
                    <Style>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>

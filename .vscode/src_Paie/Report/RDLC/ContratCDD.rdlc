                <TextRuns>
                  <TextRun>
                    <Value>=Fields!MaritalStatus.Value &amp; " " &amp; Fields!First_Name.Value &amp; " " &amp; Fields!Last_Name.Value &amp; " aura droit à un congé payé calculé conformément aux dispositions"</Value>
                    <Style>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="prévues par le Code du travail et aux dispositions réglementaires et conventionnelles applicables à l'entreprise ."</Value>
                    <Style>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Les modalités des congés seront déterminées après accord avec l'employeur, compte tenu des nécessités de service ."</Value>
                    <Style>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>

          <Textbox Name="Textbox5">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value EvaluationMode="Auto">="         Je soussigné, " &amp; Fields!MaritalStatusRH.Value &amp; " "</Value>
                    <Style>
                      <FontSize>16pt</FontSize>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">Mohamed ben Mbarek</Value>
                    <Style>
                      <FontSize>16pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=", Responsable des Ressources Humaines de la Société "</Value>
                    <Style>
                      <FontSize>16pt</FontSize>
                      <FontWeight>Normal</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=Fields!Name.Value</Value>
                    <Style>
                      <FontSize>16pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=" certifie par la présente que "</Value>
                    <Style>
                      <FontSize>16pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=Fields!MaritalStatus.Value &amp; "  "</Value>
                    <Style>
                      <FontSize>16pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=Fields!FirstName.Value &amp; "  " &amp; Fields!LastName.Value</Value>
                    <Style>
                      <FontSize>16pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=",  a été employé(e) au sein de notre société en qualité de "</Value>
                    <Style>
                      <FontSize>16pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=Fields!JobTitle.Value</Value>
                    <Style>
                      <FontSize>16pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value EvaluationMode="Auto">=" durant la période du " &amp; Fields!EmploymentDate.Value &amp; " au " &amp; Fields!TerminationDate.Value</Value>
                    <Style>
                      <FontSize>16pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
